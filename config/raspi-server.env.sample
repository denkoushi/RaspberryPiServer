# Optional overrides for raspi-server.service
# Values defined here supplement or override the .env file that docker compose reads.
# Copy this file to /etc/default/raspi-server and adjust as needed.

# POSTGRES_USER=app
# POSTGRES_PASSWORD=app_password
# POSTGRES_DB=appdb
# API_TOKEN=raspi-token-20251027            # Window A / Pi Zero と一致させる（RUNBOOK 4 章参照）
# VIEWER_DOCS_DIR=/srv/rpi-server/documents
# VIEWER_API_TOKEN=raspi-token-20251027     # DocumentViewer フロントと共有（API_TOKEN と同一値を推奨）
# VIEWER_CORS_ORIGINS=http://raspi-window-a.local:8501
# SOCKETIO_CORS_ORIGINS=http://raspi-window-a.local:8501
# VIEWER_LOG_PATH=/srv/rpi-server/logs/document_viewer.log
# SOCKET_STATUS_WATCHDOG=1                 # Window A からの再接続表示を維持
